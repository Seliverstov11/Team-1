# Скопируй в .env и при необходимости поправь. Сам .env в репозиторий не коммитим (H12).

PORT=8080
RUST_LOG=bakeloom_api=info,tower_http=info

# Локальная разработка: оставь как есть, БД создастся файлом сама.
DATABASE_PATH=data.db

# Пароль, который при старте получают сотрудники без пароля (owner, dana,
# aliya, sklad из демо-данных). Только для разработки и показа — на настоящем
# сервере задать свой, а владелец потом сменит пароли через API.
BOOTSTRAP_PASSWORD=bakeloom-demo

# Опт. Заказчик хочет одну цену для всех (встреча 3, 27:47) — по умолчанию выключен.
WHOLESALE_ENABLED=false

# Telegram-уведомления сотрудникам о новых заказах. Пусто — не отправляются.
# Токен выдаёт @BotFather, chat_id — группы, куда добавлен бот. В репозиторий не класть.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Реквизиты для накладной.
SHOP_NAME=BAKELOOM
SHOP_BIN=
SHOP_ADDRESS=

# Сколько дней действует вход.
SESSION_DAYS=30

# Фото товаров в CRM (#43). Пусто — подбор и загрузка фото отвечают 503, остальное работает.
# Pexels — подбор вариантов: https://www.pexels.com/api/ → Your API key (бесплатно).
PEXELS_API_KEY=
# Cloudinary — хранение фото: Dashboard → API Environment variable, вид cloudinary://ключ:секрет@облако.
CLOUDINARY_URL=
# Убирать фон у фото из CRM. Включать, только проверив, что эффект e_background_removal есть на аккаунте.
CLOUDINARY_REMOVE_BG=false

# Turso — только для задеплоенного демо. Пока переменные пустые,
# backend работает с локальным файлом и не требует ни токенов, ни интернета.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
