# Скопируй в .env и при необходимости поправь. Сам .env в репозиторий не коммитим.

PORT=8080
RUST_LOG=bakeloom_api=info,tower_http=info

# Локальная разработка: оставь как есть, БД создастся файлом сама.
DATABASE_PATH=data.db

# Turso — только для задеплоенного демо. Пока переменные пустые,
# backend работает с локальным файлом и не требует ни токенов, ни интернета.
# Значения брать в панели Turso, в репозиторий не класть.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
